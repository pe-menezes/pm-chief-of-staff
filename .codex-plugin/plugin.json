{
  "name": "pm-chief-of-staff",
  "version": "0.11.0",
  "description": "Personal Chief of Staff for product people: a work second brain built from your answers in a setup interview, kept in your own markdown files and adapted to you through use. Run the setup skill in an empty folder.",
  "author": {
    "name": "Pedro Menezes",
    "url": "https://github.com/pe-menezes"
  },
  "homepage": "https://github.com/pe-menezes/pm-chief-of-staff",
  "repository": "https://github.com/pe-menezes/pm-chief-of-staff",
  "license": "MIT",
  "skills": "./skills/",
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "matcher": "startup",
          "hooks": [
            {
              "type": "command",
              "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/boot-memory.sh\" codex",
              "additionalContextLimit": 3500
            }
          ]
        },
        {
          "matcher": "clear",
          "hooks": [
            {
              "type": "command",
              "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/boot-memory.sh\" codex",
              "additionalContextLimit": 3500
            }
          ]
        },
        {
          "matcher": "compact",
          "hooks": [
            {
              "type": "command",
              "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/boot-memory.sh\" codex",
              "additionalContextLimit": 3500
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/size-gate.sh\" prompt codex"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/size-gate.sh\" stop codex"
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "PM Chief of Staff",
    "shortDescription": "A work second brain in markdown, built in one conversation",
    "developerName": "Pedro Menezes",
    "category": "Productivity"
  }
}
